        "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Iteration \>\"", ",", " ", "iter", ",", " ", "\"\</\>\"", ",", 
         " ", "nIterations", ",", " ", "\"\< - archive: \>\"", ",", " ", 
         RowBox[{"Length", "[", "Xtrain", "]"}], ",", "\n", "    ", 
         "\"\< - feasible: \>\"", ",", " ", 
         RowBox[{"Length", "[", "currentFeas", "]"}], ",", " ", 
