                  RowBox[{"yNOx", "[", 
                   RowBox[{"[", "useIdx", "]"}], "]"}]}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"maxN", " ", "-", " ", "minN"}], ")"}]}]}]}], 
             "]"}]}], ";", "\n", "    ", 
           RowBox[{"acqVals", " ", "=", " ", 
