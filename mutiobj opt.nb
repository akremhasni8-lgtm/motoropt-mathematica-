                RowBox[{"[", "2", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@",
             " ", "iterationLog"}], ",", " ", 
           RowBox[{
            RowBox[{"NumericQ", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}], " ", "&"}]}], "]"}], ",",
