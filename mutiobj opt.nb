              RowBox[{"5", ",", " ", "2"}], "}"}]}], "]"}], " ", "&"}], ",", 
          " ", "paretoRows", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", "\n", "    ", 
