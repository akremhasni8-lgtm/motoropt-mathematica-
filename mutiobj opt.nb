Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "finalFeasIdx", "]"}], " ", ">", " ", "0"}], ",",
      "\n", "\n", " ", 
     RowBox[{
      RowBox[{"infeasIdx", " ", "=", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "Xtrain", "]"}], "]"}], ",", " ", 
         "finalFeasIdx"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"dominatedFeasIdx", " ", "=", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{"finalFeasIdx", ",", " ", "paretoGlobalIdx"}], "]"}]}], ";", 
      "\n", "\n", " ", 
      RowBox[{"paretoPlot", " ", "=", " ", 
       RowBox[{"ListPlot", "[", "\n", "   ", 
        RowBox[{
         RowBox[{"{", "\n", "    ", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"yTorque", "[", 
               RowBox[{"[", "infeasIdx", "]"}], "]"}], ",", " ", 
              RowBox[{"yNOx", "[", 
               RowBox[{"[", "infeasIdx", "]"}], "]"}]}], "}"}], "]"}], ",", 
           "\n", "    ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"yTorque", "[", 
               RowBox[{"[", "dominatedFeasIdx", "]"}], "]"}], ",", " ", 
              RowBox[{"yNOx", "[", 
               RowBox[{"[", "dominatedFeasIdx", "]"}], "]"}]}], "}"}], "]"}], 
           ",", "\n", "    ", 
           RowBox[{"SortBy", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"yTorque", "[", 
                 RowBox[{"[", "paretoGlobalIdx", "]"}], "]"}], ",", " ", 
                RowBox[{"yNOx", "[", 
                 RowBox[{"[", "paretoGlobalIdx", "]"}], "]"}]}], "}"}], "]"}],
              ",", " ", "First"}], "]"}]}], "\n", "   ", "}"}], ",", "\n", 
         "   ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"{", "\n", "     ", 
           RowBox[{
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", 
              RowBox[{"Opacity", "[", "0.4", "]"}], ",", " ", 
              RowBox[{"PointSize", "[", "0.012", "]"}]}], "]"}], ",", "\n", 
            "     ", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"RGBColor", "[", 
               RowBox[{"0.2", ",", " ", "0.4", ",", " ", "0.8"}], "]"}], ",", 
              " ", 
              RowBox[{"PointSize", "[", "0.014", "]"}]}], "]"}], ",", "\n", 
            "     ", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"RGBColor", "[", 
               RowBox[{"0.85", ",", " ", "0.2", ",", " ", "0.2"}], "]"}], ",",
               " ", 
              RowBox[{"PointSize", "[", "0.02", "]"}]}], "]"}]}], "\n", "   ",
            "}"}]}], ",", "\n", "   ", 
         RowBox[{"Joined", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"False", ",", " ", "False", ",", " ", "True"}], "}"}]}], 
         ",", "\n", "   ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
           "\"\<infeasible (T4 > threshold)\>\"", ",", " ", 
            "\"\<feasible, dominated\>\"", ",", " ", "\"\<Pareto front\>\""}],
            "}"}]}], ",", "\n", "   ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "   ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Torque [Nm]  (maximize)\>\"", ",", " ", 
            "\"\<NOx [ppm]  (minimize)\>\""}], "}"}]}], ",", "\n", "   ", 
         RowBox[{
         "PlotLabel", " ", "->", " ", 
          "\"\<Engine calibration: Torque vs NOx (T4-constrained batch \
EI)\>\""}], ",", "\n", "   ", 
         RowBox[{"ImageSize", " ", "->", " ", "520"}]}], "\n", " ", "]"}]}], 
      ";", "\n", "\n", " ", 
      RowBox[{"convergencePlot", " ", "=", " ", 
       RowBox[{"ListLinePlot", "[", "\n", "   ", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
