Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"finalFeasIdx", " ", "=", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Position", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"yT4", " ", "<=", " ", "t4Threshold"}], "]"}], ",", " ", 
       "True"}], "]"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "finalFeasIdx", "]"}], " ", "==", " ", "0"}], ",",
     "\n", "  ", 
    RowBox[{
    "Print", "[", 
     "\"\<WARNING: no feasible point satisfies the T4 threshold - consider \\\
\nraising t4Percentile or nIterations.\>\"", "]"}], ",", "\n", "\n", "  ", 
    RowBox[{
     RowBox[{"objMatrix", " ", "=", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"yTorque", "[", 
          RowBox[{"[", "finalFeasIdx", "]"}], "]"}], ",", " ", 
         RowBox[{"-", 
          RowBox[{"yNOx", "[", 
           RowBox[{"[", "finalFeasIdx", "]"}], "]"}]}]}], "}"}], "]"}]}], ";",
      "\n", "  ", 
     RowBox[{"paretoGlobalIdx", " ", "=", " ", 
      RowBox[{"finalFeasIdx", "[", 
       RowBox[{"[", 
        RowBox[{"paretoIndices", "[", "objMatrix", "]"}], "]"}], "]"}]}], ";",
      "\n", "\n", "  ", 
     RowBox[{"paretoRows", " ", "=", " ", 
      RowBox[{"SortBy", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{"#1", ",", " ", 
             RowBox[{"{", 
              RowBox[{"#2", ",", " ", "#3", ",", " ", "#4"}], "}"}]}], "]"}], 
           " ", "&"}], ",", "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Xtrain", "[", 
             RowBox[{"[", "paretoGlobalIdx", "]"}], "]"}], ",", " ", 
            RowBox[{"yTorque", "[", 
             RowBox[{"[", "paretoGlobalIdx", "]"}], "]"}], ",", "\n", 
            "       ", 
            RowBox[{"yT4", "[", 
             RowBox[{"[", "paretoGlobalIdx", "]"}], "]"}], ",", " ", 
            RowBox[{"yNOx", "[", 
             RowBox[{"[", "paretoGlobalIdx", "]"}], "]"}]}], "}"}]}], "]"}], 
        ",", "\n", "    ", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"#", "[", 
           RowBox[{"[", "11", "]"}], "]"}]}], " ", "&"}]}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"sort", " ", "by", " ", "Torque"}], ",", " ", "descending"}], 
      " ", "*)"}], "\n", "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<\\nPareto-optimal operating points (Torque up, NOx down, T4 <= \
\>\"", ",", "\n", "    ", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"t4Threshold", ",", " ", 
         RowBox[{"{", 
          RowBox[{"5", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", 
       "\"\<), \>\"", ",", " ", 
       RowBox[{"Length", "[", "paretoRows", "]"}], ",", " ", 
       "\"\< points found:\>\""}], "]"}], ";", "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"TableForm", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Map", "[", 
