Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t4Threshold", " ", "=", " ", 
     RowBox[{"Quantile", "[", 
      RowBox[{"yT4", ",", " ", "t4Percentile"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Custom threshold on T4: T4 <= \>\"", ",", " ", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"t4Threshold", ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", 
      "\"\< degC\>\""}], "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"iterationLog", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"{", 
     RowBox[{
     "iteration", ",", " ", "bestFeasibleTorque", ",", " ", "nFeasible"}], 
     "}"}], " ", "*)"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"predTorque", " ", "=", " ", 
        RowBox[{"buildDesignGP", "[", 
         RowBox[{"Xtrain", ",", " ", "yTorque"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"predNOx", "    ", "=", " ", 
        RowBox[{"buildDesignGP", "[", 
         RowBox[{"Xtrain", ",", " ", "yNOx"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"predT4", "     ", "=", " ", 
        RowBox[{"buildDesignGP", "[", 
         RowBox[{"Xtrain", ",", " ", "yT4"}], "]"}]}], ";", "\n", "\n", "  ", 
       RowBox[{"feasMask", " ", "=", " ", 
        RowBox[{"Thread", "[", 
         RowBox[{"yT4", " ", "<=", " ", "t4Threshold"}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"minT", ",", " ", "maxT"}], "}"}], " ", "=", " ", 
        RowBox[{"MinMax", "[", "yTorque", "]"}]}], ";", "\n", "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"minN", ",", " ", "maxN"}], "}"}], " ", "=", " ", 
        RowBox[{"MinMax", "[", "yNOx", "]"}]}], ";", "\n", "  ", 
       RowBox[{"feasIdx", " ", "=", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"feasMask", ",", " ", "True"}], "]"}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"useIdx", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "feasIdx", "]"}], " ", ">", " ", "0"}], ",",
           " ", "feasIdx", ",", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "yTorque", "]"}], "]"}]}], "]"}]}], ";", 
       "\n", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
          "shared", " ", "candidate", " ", "pool", " ", "for", " ", "this", 
           " ", "iteration"}], ";", " ", 
          RowBox[{
           RowBox[{"candidates", " ", "are", " ", "10"}], "-", 
           RowBox[{"D", " ", "design", "\n", "     ", "vectors"}]}]}], ",", 
         " ", 
         RowBox[{
         "so", " ", "every", " ", "GP", " ", "query", " ", "needs", " ", 
          "contextFixed", " ", "appended", " ", "first"}]}], " ", "*)"}], 
       "\n", "  ", 
       RowBox[{"candidates", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"lb", "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
             RowBox[{"ub", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", "nCandidatesAcq", "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", 
            RowBox[{"Length", "[", "lb", "]"}]}], "}"}]}], "]"}]}], ";", "\n",
        "  ", 
       RowBox[{"candFull", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"#", ",", " ", "contextFixed"}], "]"}], " ", "&"}], " ", "/@",
          " ", "candidates"}]}], ";", "\n", "  ", 
       RowBox[{"candMu1", "  ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"meanOf", "[", 
           RowBox[{"predTorque", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
          " ", "candFull"}]}], ";", "\n", "  ", 
       RowBox[{"candS1", "   ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"stdOf", "[", 
           RowBox[{"predTorque", ",", " ", "#"}], "]"}], "  ", "&"}], " ", "/@",
          " ", "candFull"}]}], ";", "\n", "  ", 
       RowBox[{"candMu2", "  ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"meanOf", "[", 
           RowBox[{"predNOx", ",", " ", "#"}], "]"}], "    ", "&"}], " ", "/@",
          " ", "candFull"}]}], ";", "\n", "  ", 
       RowBox[{"candS2", "   ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"stdOf", "[", 
           RowBox[{"predNOx", ",", " ", "#"}], "]"}], "     ", "&"}], " ", "/@",
          " ", "candFull"}]}], ";", "\n", "  ", 
       RowBox[{"candPF", "   ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"CDF", "[", 
           RowBox[{
            RowBox[{"predT4", "[", 
             RowBox[{"#", ",", " ", "\"\<Distribution\>\""}], "]"}], ",", " ",
             "t4Threshold"}], "]"}], " ", "&"}], " ", "/@", " ", 
         "candFull"}]}], ";", "\n", "\n", "  ", 
       RowBox[{"chosenIdx", " ", "=", " ", 
