         RowBox[{
         "PlotLabel", " ", "->", " ", 
          "\"\<Convergence of the batch constrained-EI search\>\""}], ",", 
         "\n", "   ", 
         RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "\n", " ", "]"}]}], 
      ";", "\n", "\n", " ", 
      RowBox[{"designPlot", " ", "=", " ", 
       RowBox[{"ListPlot", "[", "\n", "   ", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Xtrain", "[", 
             RowBox[{"[", 
