    RowBox[{"closed", "-", 
     RowBox[{"form", " ", "Expected", " ", "Improvement"}]}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"expectedImprovement", "[", 
      RowBox[{
       RowBox[{"mu_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"sigma_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"best_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sigma", " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "8"}]}]}], ",", " ", "0.", ",", "\n", "   ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"z", " ", "=", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"mu", " ", "-", " ", "best"}], ")"}], "/", "sigma"}]}], 
          "}"}], ",", "\n", "    ", 
         RowBox[{"sigma", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"z", "*", 
             RowBox[{"CDF", "[", 
              RowBox[{
               RowBox[{"NormalDistribution", "[", 
                RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "z"}], "]"}]}],
             " ", "+", " ", 
            RowBox[{"PDF", "[", 
             RowBox[{
              RowBox[{"NormalDistribution", "[", 
               RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "z"}], "]"}]}], 
           ")"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"custom", " ", "Pareto"}], "-", 
       RowBox[{"front", " ", "filter", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"no", " ", "built"}], "-", 
          RowBox[{"in", " ", "multi"}], "-", 
          RowBox[{
          "objective", " ", "Pareto", " ", "function", " ", "in", "\n", "   ",
            "Wolfram", " ", "Language"}]}], ")"}]}]}], ":", " ", 
      RowBox[{
      "obj", " ", "is", " ", "a", " ", "list", " ", "of", " ", "vectors"}]}], 
     ",", " ", 
     RowBox[{
      RowBox[{"ALL", " ", "objectives", " ", "MAXIMIZED"}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"returns", " ", "indices", " ", "of", " ", "the", " ", "non"}],
        "-", 
       RowBox[{"dominated", " ", "points"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"paretoIndices", "[", "obj_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", " ", "=", " ", 
          RowBox[{"Length", "[", "obj", "]"}]}], ",", " ", "dominated"}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"dominated", " ", "=", " ", 
         RowBox[{"Table", "[", "\n", "     ", 
          RowBox[{
           RowBox[{"AnyTrue", "[", 
            RowBox[{
             RowBox[{"Delete", "[", 
              RowBox[{
               RowBox[{"Range", "[", "n", "]"}], ",", " ", "i"}], "]"}], ",", 
             "\n", "       ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"And", " ", "@@", " ", 
                 RowBox[{"Thread", "[", 
                  RowBox[{
                   RowBox[{"obj", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], " ", ">=", " ", 
                   RowBox[{"obj", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], " ", "&&", 
                "\n", "         ", 
                RowBox[{"Or", " ", "@@", " ", 
                 RowBox[{"Thread", "[", 
                  RowBox[{
                   RowBox[{"obj", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], " ", ">", " ", 
                   RowBox[{"obj", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}]}], ")"}], " ", 
              "&"}]}], "]"}], ",", "\n", "     ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "n"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"Pick", "[", 
         RowBox[{
          RowBox[{"Range", "[", "n", "]"}], ",", " ", "dominated", ",", " ", 
          "False"}], "]"}]}]}], "\n", "]"}]}], ";"}]}]}]], "Input",
