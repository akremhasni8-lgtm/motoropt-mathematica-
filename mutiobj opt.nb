                    RowBox[{"[", "k", "]"}], "]"}], " ", "-", " ", "minT"}], 
                    ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"maxT", " ", "-", " ", "minT"}], ")"}]}]}], " ", 
                    "+", "\n", "            ", 
                    RowBox[{"lambda2", "*", 
