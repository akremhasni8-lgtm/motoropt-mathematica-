           RowBox[{"Length", "[", "currentFeas", "]"}], " ", ">", " ", "0"}], 
          ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"yTorque", "[", 
            RowBox[{"[", "currentFeas", "]"}], "]"}], "]"}], ",", " ", 
