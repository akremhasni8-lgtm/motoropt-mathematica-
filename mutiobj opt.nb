                  RowBox[{"{", 
                   RowBox[{"muZ", ",", " ", "sigZ", ",", " ", "ei"}], "}"}], 
                  ",", "\n", "         ", 
                  RowBox[{
                   RowBox[{"muZ", " ", "=", " ", 
                    RowBox[{
